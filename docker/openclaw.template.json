{
  "gateway": {
    "mode": "local",
    "port": 18789,
    "bind": "loopback",
    "trustedProxies": ["127.0.0.1", "::1"],
    "auth": {
      "mode": "none",
      "token": "${BROWSER_CONTROL_TOKEN}"
    },
    "controlUi": {
      "enabled": true,
      "basePath": "/openclaw",
      "allowedOrigins": ["*"],
      "dangerouslyDisableDeviceAuth": false
    }
  },
  "channels": {
    "feishu": {
      "enabled": ${FEISHU_ENABLED},
      "defaultAccount": "main",
      "connectionMode": "websocket",
      "domain": "${FEISHU_DOMAIN}",
      "dmPolicy": "${FEISHU_DM_POLICY}",
      "allowFrom": ${FEISHU_ALLOW_FROM_JSON},
      "accounts": {
        "main": {
          "appId": "${FEISHU_APP_ID}",
          "appSecret": "${FEISHU_APP_SECRET}",
          "domain": "${FEISHU_DOMAIN}"
        }
      }
    },
    "email": {
      "enabled": ${EMAIL_ENABLED},
      "allowFrom": ["*"],
      "replyMode": "complete",
      "replyTo": "sender",
      "accounts": {
        "default": {
          "email": "${EMAIL_ACCOUNT}",
          "password": "${EMAIL_TOKEN}",
          "transport": "${EMAIL_MODE}"
        }
      }
    }
  },
  "plugins": {
    "entries": {
      "feishu": { "enabled": true },
      "file-transfer": { "enabled": true },
      "memory-core": { "enabled": true },
      "talk-voice": { "enabled": true },
      "browser": { "enabled": false },
      "canvas": { "enabled": false },
      "phone-control": { "enabled": false }
    }
  },
  "skills": {
    "entries": {}
  },
  "models": {
    "mode": "merge",
    "providers": {
      "dashscope": {
        "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "apiKey": "${DASHSCOPE_API_KEY}",
        "api": "openai-completions",
        "models": [
          { "id": "qwen-turbo", "name": "Qwen Turbo (DashScope)" },
          { "id": "qwen-plus", "name": "Qwen Plus (DashScope)" }
        ]
      },
      "siliconflow": {
        "baseUrl": "https://api.siliconflow.cn/v1",
        "apiKey": "${SILICONFLOW_API_KEY}",
        "api": "openai-completions",
        "models": [
          { "id": "Qwen/Qwen3-8B", "name": "Qwen3 8B (SiliconFlow Free, 131K)" },
          { "id": "deepseek-ai/DeepSeek-R1-Distill-Qwen-7B", "name": "DeepSeek R1 Distill Qwen 7B (SiliconFlow Free, 131K)" },
          { "id": "THUDM/GLM-Z1-9B-0414", "name": "GLM-Z1 9B (SiliconFlow Free, reasoning)" }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "${OPENCLAW_DEFAULT_MODEL}"
      }
    }
  },
  "env": {
    "OPENROUTER_API_KEYS": "${OPENROUTER_API_KEYS}",
    "DASHSCOPE_API_KEY": "${DASHSCOPE_API_KEY}",
    "SILICONFLOW_API_KEY": "${SILICONFLOW_API_KEY}",
    "FEISHU_APP_ID": "${FEISHU_APP_ID}",
    "FEISHU_APP_SECRET": "${FEISHU_APP_SECRET}"
  }
}
